TASKFLOW_SECRET_KEY=replace-with-a-long-random-value
TASKFLOW_DATABASE_URI=sqlite:///instance/taskflow.db
TASKFLOW_COOKIE_SECURE=false
# Production database option:
# TASKFLOW_DATABASE_URI=postgresql+psycopg://taskflow:password@localhost:5432/taskflow
# Optional Redis URL for background workers:
# REDIS_URL=redis://localhost:6379/0
# Password reset email and optional SMTP alerts:
# TASKFLOW_PUBLIC_URL=http://localhost:5001
# TASKFLOW_SMTP_HOST=smtp.example.com
# TASKFLOW_SMTP_PORT=587
# TASKFLOW_SMTP_USER=alerts@example.com
# TASKFLOW_SMTP_PASSWORD=replace-with-an-app-password
# TASKFLOW_SMTP_FROM=taskflow@example.com
# TASKFLOW_SMTP_STARTTLS=true
# TASKFLOW_ALERT_EMAIL=owner@example.com